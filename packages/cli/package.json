    "test": "vitest run"
  },
  "dependencies": {
    "@featherduster/core": "*",
    "@hono/node-server": "^1.13.7",
    "cac": "^6.7.14",
    "chokidar": "^3.6.0",
    "hono": "^4.6.14",
    "js-yaml": "^4.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
