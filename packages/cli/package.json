{
  "name": "@featherduster/cli",
  "version": "0.1.0",
  "description": "CLI and local server for Featherduster — local-first career intelligence and evidence ledger",
  "license": "MIT",
  "type": "module",
  "bin": {
    "featherduster": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
