{
  "name": "featherduster-app",
  "version": "0.1.0",
  "description": "Local-First Career Intelligence & Evidence Ledger for Engineers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build && node packages/cli/dist/bin.js",
    "build:core": "npm run build --workspace=@featherduster/core",
    "build:ui": "npm run build --workspace=@featherduster/ui",
    "build:cli": "npm run build --workspace=@featherduster/cli",
    "build": "npm run build:core && npm run build:ui && npm run build:cli",
    "test": "vitest run",
    "walkthrough": "node scripts/run-walkthrough.mjs",
    "walkthrough:tailoring": "node scripts/run-tailoring-walkthrough.mjs",
    "ideas": "python scripts/autonomous_feature_pipeline.py",
    "ideas:scan": "python scripts/loop_idea_scanner.py",
    "ideas:curate": "python scripts/loop_proposal_curator.py",
    "ideas:pipeline": "python scripts/autonomous_feature_pipeline.py",
    "ideas:execute": "python scripts/loop_task_executor.py",
    "ideas:adw": "uv run adws/adw_plan_build_verify_fd.py"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
